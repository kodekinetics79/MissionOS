{
  "scripts": {
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:api\"",
    "build": "npm run build:web && npm run build:api",
    "test": "tsx --test server/src/services/authService.test.ts server/src/routes/crud.test.ts server/src/middleware/tenantGuard.test.ts server/src/utils/prisma.test.ts",
    "check": "npm run test && npm run build",
    "preview": "vite preview --host 0.0.0.0 --port 9911",
    "dev:web": "vite --host 0.0.0.0 --port 9911",
    "dev:api": "tsx watch server/src/index.ts",
    "build:web": "tsc -b && vite build",
    "build:api": "tsc -p server/tsconfig.json",
    "db:generate": "tsx server/src/scripts/initDb.ts",
    "db:migrate": "tsx server/src/scripts/initDb.ts",
    "db:seed": "tsx server/src/scripts/initDb.ts",
    "db:studio": "node -e \"console.log('SQLite database at data/missionos.sqlite')\"",
    "api": "node server/dist/index.js"
  },
  "dependencies": {
    "@types/pg": "^8.20.0",
    "@vitejs/plugin-react": "latest",
    "bcryptjs": "latest",
    "cors": "latest",
    "dotenv": "latest",
    "express": "latest",
    "express-rate-limit": "^8.5.2",
    "helmet": "latest",
    "jsonwebtoken": "latest",
    "lucide-react": "latest",
    "morgan": "latest",
    "otplib": "^12.0.1",
    "pg": "^8.21.0",
    "react": "latest",
    "react-dom": "latest",
    "recharts": "latest",
    "typescript": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/bcryptjs": "latest",
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/jsonwebtoken": "latest",
    "@types/morgan": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "4.5.2",
    "concurrently": "latest",
    "tsx": "latest",
    "typescript": "^5.9.3",
    "vite": "7.2.7"
  },
  "engines": {
    "node": "22.x"
  }
}
