# MissionOS environment (example). Copy to .env and fill in. NEVER commit .env.
# --- Database ---
# Neon pooled URL (non-local host => Postgres backend). TLS verified by default.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
# PG_SSL_NO_VERIFY=true   # escape hatch only; leave unset to verify certs

# --- Auth secrets (generate: openssl rand -hex 48) ---
JWT_SECRET="replace-with-a-strong-32+-char-random-secret"
JWT_REFRESH_SECRET="replace-with-a-second-strong-random-secret"
# JWT_ACCESS_TTL=2h
# JWT_REFRESH_TTL=7d

# --- MFA (TOTP) ---
# MFA_REQUIRED_FOR_ADMIN=true     # require admins to enrol MFA (default off)
# MFA_PROTECT_EMAILS=admin@westmetro.example   # accounts blocked from enabling MFA

# --- Server ---
PORT=4100
CORS_ORIGIN=http://localhost:9911
AI_PROVIDER=mock
OLLAMA_BASE_URL=http://localhost:11434

# --- Frontend build (Vercel) ---
# VITE_API_URL=https://your-api-host/api   # SPA calls this; unset => demo fallback
