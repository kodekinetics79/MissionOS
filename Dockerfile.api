# MissionOS API — persistent Node host (Railway / Render / Fly / VM).
# The API keeps an in-memory read cache hydrated from Postgres at boot, so it is
# designed for a long-lived process, NOT per-request serverless cold starts.
FROM node:22-slim
WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build:api

ENV NODE_ENV=production
ENV PORT=4100
EXPOSE 4100

# Seed runs only if the records table is empty (idempotent); then start the API.
CMD ["sh", "-c", "node server/dist/index.js"]
